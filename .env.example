# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite default for zero-config local run, or PostgreSQL for production/docker)
DATABASE_URL="file:./dev.db"
# For PostgreSQL docker: DATABASE_URL="postgresql://craftverse:craftverse_secure_password@localhost:5432/craftverse_db?schema=public"

# Security & Authentication
JWT_SECRET=craftverse_super_secret_jwt_access_key_2026_production
JWT_REFRESH_SECRET=craftverse_super_secret_jwt_refresh_key_2026_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Gateway
FRONTEND_URL=http://localhost:5173
SOCKET_URL=http://localhost:5000

# Hospital Queue Engine Defaults
DEFAULT_CONSULTATION_DURATION_MINUTES=15
DEFAULT_SAFETY_BUFFER_MINUTES=10
DEFAULT_TRAVEL_TIME_MINUTES=25
EMERGENCY_PRIORITY_BONUS=2
